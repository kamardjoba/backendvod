NODE_ENV=production
PORT=3001
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/driverrest?retryWrites=true&w=majority
SESSION_SECRET=change-me-to-a-long-random-string
# Точный URL фронта в браузере (Netlify), без слэша в конце
CLIENT_ORIGIN=https://your-app.netlify.app
DEFAULT_TIMEZONE=Europe/Warsaw
SEED_DEV=false
# Первая запись админа (один раз): если в MongoDB ещё нет role=administrator,
# при старте production создаётся пользователь с этим email/паролем. Дальше только вход.
ADMIN_EMAIL=admin@driverrest.local
ADMIN_PASSWORD=Admin123!
